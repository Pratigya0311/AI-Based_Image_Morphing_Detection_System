# Never commit the real .env file. Copy this file to .env and fill local values.
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
DATABASE_URL=

# Private Hugging Face model repository used when local files are unavailable.
HF_TOKEN=hf_read_token_for_deployment_only
HF_MODEL_REPO=vjpratigya/ai-morph-detection-models
HF_MODEL_REVISION=v1.0.0

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification and password-reset delivery (use a deployment SMTP provider).
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Private deployment administrator. Never put the actual password in Git.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_INITIAL_PASSWORD=choose-a-long-unique-password
